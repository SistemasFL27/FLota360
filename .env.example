DATABASE_URL=sqlite:///./flota360.db

# Customer API Location World / YPF Ruta
# Auth0: no pedir más de 1 token cada 24 h. El conector lo reutiliza desde .ypf_token_cache.json
# Customer API rate limit: 2 requests por segundo
LOCATIONWORLD_CLIENT_ID=
LOCATIONWORLD_CLIENT_SECRET=
LOCATIONWORLD_AUDIENCE=https://customer-api.location-world.com
# MAG YPF: producción https://mag.ypf.com/auth/oauth/v2/token
# Si las credenciales son de testing, pedí la URL de token de test y ponela acá
YPF_TOKEN_URL=https://mag.ypf.com/auth/oauth/v2/token
YPF_CLIENT_ID=
YPF_CLIENT_SECRET=
YPF_SCOPE=
YPF_USERNAME=
YPF_PASSWORD=
YPF_API_BASE=https://customer-api.location-world.com
YPF_API_DOMAIN=fleet
YPF_API_SUBDOMAIN=ypfruta
